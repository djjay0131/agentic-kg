# .gcloudignore - Exclude files from Cloud Build context
# This reduces upload size and speeds up builds

# Git
.git
.gitignore
.github

# Claude Code
.claude

# Documentation (except README)
*.md
!README.md
docs/
examples/

# Tests
tests/
.pytest_cache/
.coverage
htmlcov/

# Control plane (agentic-governance ADR-0001): agent-facing project files —
# governance delta + ADRs, feature specs, memory bank, sprint history, plans.
# None of it is runtime code, so it stays out of the build context. The data
# plane (docs/) is excluded above.
llm/

# Python artifacts
*.pyc
__pycache__/
*.egg-info/
dist/
build/
.eggs/

# Environment
.env*
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
